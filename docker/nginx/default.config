version: "3.8"
services:
  app:
    image: php:8.1-fpm
    container_name: pm_app
    working_dir: /var/www
    volumes:
      - ./:/var/www
      - ./docker/php/php.ini:/usr/local/etc/php/conf.d/custom.ini
    depends_on:
      - db
    networks:
      - pm_network
    environment:
      - COMPOSER_ALLOW_SUPERUSER=1
  web:
    image: nginx:stable
    container_name: pm_web
    ports:
      - "8080:80"
    volumes:
      - ./:/var/www
      - ./docker/nginx/default.conf:/etc/nginx/conf.d/default.conf
    depends_on:
      - app
    networks:
      - pm_network
  db:
    image: mysql:8.0
    container_name: pm_db
    environment:
      MYSQL_ROOT_PASSWORD: rootpass
      MYSQL_DATABASE: property_manager
      MYSQL_USER: pm_user
      MYSQL_PASSWORD: pmpassword
    ports:
      - "3306:3306"
    volumes:
      - dbdata:/var/lib/mysql
    networks:
      - pm_network
volumes:
  dbdata:
networks:
  pm_network:
    driver: bridge
