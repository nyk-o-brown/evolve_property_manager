# Environment Configuration Example
# Copy this to .env in your React project root and update with your values

# Development Environment
VITE_API_URL=http://localhost/evolve_property_manager/react_taiwind_postgreess_base_plate/backend/api
VITE_APP_NAME=Evolve Property Manager
VITE_APP_VERSION=1.0.0
VITE_DEBUG=true

# Production Environment (cPanel)
# VITE_API_URL=https://yourdomain.com/api
# VITE_APP_NAME=Evolve Property Manager
# VITE_APP_VERSION=1.0.0
# VITE_DEBUG=false

# Optional: Firebase / Push Notifications
# VITE_FIREBASE_API_KEY=your_key_here
# VITE_FIREBASE_AUTH_DOMAIN=your_domain_here
# VITE_FIREBASE_PROJECT_ID=your_project_id_here

# Optional: Payment Gateway
# VITE_STRIPE_PUBLIC_KEY=pk_live_your_key_here

# Optional: Analytics
# VITE_GOOGLE_ANALYTICS_ID=UA-000000000-0
